#!/bin/bash
# --acls              - Preserve ACL
# --archive           - Archive. This is equivalent to -rlptgoD
# --delete-before     - kinda self explanitory
# --executability     - Preserve Executability
# --human-readable    -
# --one-file-system   - Don't cross file system boundaries
# --verbose --verbose - By default, rsync works silently. A single -v will give you information about what
#                       files are being transferred and a brief summary at the end. Two -v options will
#                       give you information on what files are being skipped and slightly more information
#                       at the end.
# --xattrs            - Preserve extended attributes

# OneDrive (handled by onedrive sync client) - WE DO NOT HAVE TO REQUEST A SYNC
# rsync $rsync_defaults_for_whole_drive_backup /media/${SUDO_USER:-$USER}/OneDrive/ /media/${SUDO_USER:-$USER}/AkiensWorld/OneDrive

# GoogleDrive (handled by TBD) - AS YET UNKNOWN
# 1) Run google-drive-ocamlfuse in the command line
# 2) Create folder for mounting at /media/${SUDO_USER:-$USER}/GoogleDrive
# 3) Run google-drive-ocamlfuse ~/googledrive to mount Google Drive
# rsync $rsync_defaults_for_whole_drive_backup /media/${SUDO_USER:-$USER}/GoogleDrive/ /media/${SUDO_USER:-$USER}/AkiensWorld/GoogleDrive

# find "$src" -type d -empty -delete
# rsync -avxc --remove-source-files /media/${SUDO_USER:-$USER}/NAS1/OLD/ /media/${SUDO_USER:-$USER}/NAS2AkiensWorld/OLD/

logtarget=${AKIENTOOLS_LOGS:-$HOME/.local/state/akientools/logs}/drives_backup.log
. logger_for_bash
copyafolder() {
    logecho "####################################################################################################"
    logecho "Performing archive copy from $source to $target"
    compelte_command="rsync $rsync_parameters $source $target"
    if [ "$dry_run" == "True" ]  ; then
        logecho "drives_backup DRY RUN: ${compelte_command}"
        logecho "result_code=0"
    else
        if [ -e "$source" ] ; then
            if [ -e "$target" ] ; then
                logcmd $compelte_command
            else
                logecho "ERROR: DESTINATION FAILURE: $target was not found"
            fi
        else
            logecho "ERROR: SOURCE FAILURE: $source was not found"
        fi
    fi
    logecho "####################################################################################################"
    logecho ""
}

logecho "Starting full drives backup"

dry_run=False

####################################################################################################
# update onedrive first
if [ "$dry_run" == "True" ]  ; then
    logecho "drives_backup DRY RUN: onedrive --sync --verbose"
else
    logcmd onedrive --sync --verbose
    logcmd onedrive --monitor &
fi

if [ "1."=="2." ] ; then
    rsync_parameters="-avx --delete "
    source=/media/${SUDO_USER:-$USER}/AkiensWorld/
    target=/media/${SUDO_USER:-$USER}/NAS/
    copyafolder

    ####################################################################################################
    # This group migrates from AkiensWorld.bak drive to the smaller drives
    # Purpose of that is so we have 2 versioned backups. Gives us
    # a better chance of recovery if there's an issue. The error
    # won't automagically propogate to all the backup devices

    source=/media/${SUDO_USER:-$USER}/AkiensWorld.bak/Porn/
    target=/media/${SUDO_USER:-$USER}/1TBUSBSSD1/
    copyafolder

    source=/media/${SUDO_USER:-$USER}/AkiensWorld.bak/Dev/
    target=/media/${SUDO_USER:-$USER}/1TBUSBSSD1/
    copyafolder

    source=/media/${SUDO_USER:-$USER}/AkiensWorld.bak/Ebooks/
    target=/media/${SUDO_USER:-$USER}/1TBUSBSSD1/
    copyafolder

    source=/media/${SUDO_USER:-$USER}/AkiensWorld.bak/Fonts/
    target=/media/${SUDO_USER:-$USER}/1TBUSBSSD1/
    copyafolder

    source=/media/${SUDO_USER:-$USER}/AkiensWorld.bak/GoogleDrive/
    target=/media/${SUDO_USER:-$USER}/1TBUSBSSD1/
    copyafolder

    source=/media/${SUDO_USER:-$USER}/AkiensWorld.bak/Music/
    target=/media/${SUDO_USER:-$USER}/1TBUSBSSD1/
    copyafolder

    source=/media/${SUDO_USER:-$USER}/AkiensWorld.bak/MusicRelated/
    target=/media/${SUDO_USER:-$USER}/1TBUSBSSD1/
    copyafolder

    source=/media/${SUDO_USER:-$USER}/AkiensWorld.bak/OneDrive/
    target=/media/${SUDO_USER:-$USER}/1TBUSBSSD1/
    copyafolder

    source=/media/${SUDO_USER:-$USER}/AkiensWorld.bak/People/
    target=/media/${SUDO_USER:-$USER}/1TBUSBSSD1/
    copyafolder

    source=/media/${SUDO_USER:-$USER}/AkiensWorld.bak/Pictures/
    target=/media/${SUDO_USER:-$USER}/1TBUSBSSD1/
    copyafolder

    source=/media/${SUDO_USER:-$USER}/AkiensWorld.bak/WindowsProvisioning/
    target=/media/${SUDO_USER:-$USER}/1TBUSBSSD1/
    copyafolder

    ####################################################################################################
    # AkiensWorld.Video on 1TBUSBSSD2
    source=/media/${SUDO_USER:-$USER}/AkiensWorld.bak/Video/
    target=/media/${SUDO_USER:-$USER}/1TBUSBSSD2/
    copyafolder

    ####################################################################################################
    # AkiensWorld done after the above so those get the second backup mentioned above.
    source=/media/${SUDO_USER:-$USER}/AkiensWorld/
    target=/media/${SUDO_USER:-$USER}/AkiensWorld.bak/
    copyafolder

    ####################################################################################################
    # Boot drive kubuntu_2404
    source=/
    target=/media/${SUDO_USER:-$USER}/kubuntu_2404.bak/
    rsync_parameters='-avx --delete --exclude={"/dev/*","/proc/*","/sys/*","/tmp/*","/run/*","/mnt/*","/media/*","/lost+found/*"}'
    copyafolder

    ####################################################################################################
fi
logecho "Done"
